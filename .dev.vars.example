# 模型服务，默认 deepseek（官方接口，填 DEEPSEEK_API_KEY）；改成 juzi 走公司统一模型网关，填 JUZI_MODELS_KEY
AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
JUZI_MODELS_KEY=
# 可选：模型名和网关地址，默认 claude-5.5-sonnet、https://unified-kiro-gateway.juzibot.com/models/v1
AGENT_MODEL=
MODEL_GATEWAY_URL=
# Agent 服务地址，留空时用 http://127.0.0.1:8788
AGENT_SERVICE_URL=
# 可选：页面服务和 Agent 服务之间的共享口令，两边读同一个值
AGENT_SERVICE_TOKEN=
# 可选：外挂历史知识目录，包含observations-202508.json和evidence/，客户数据不放仓库
ANALYTICS_HISTORY_DIR=
# 可选：问题、计算、业务草稿与复核记录的私有目录，必须位于仓库之外
ANALYTICS_AUDIT_DIR=
# 可选：本地历史数据库，仅Agent读取；留空HOST时不启用
CTF_MYSQL_HOST=
CTF_MYSQL_PORT=3306
CTF_MYSQL_USER=
CTF_MYSQL_PASSWORD=
CTF_MYSQL_DATABASE=
CTF_MYSQL_TABLE=
# 查询证据保存在仓库外的私有目录
CTF_MYSQL_EVIDENCE_DIR=
# 分析问答仅复用当前只读事务的查询结果；源修订尚未可靠确认，跨会话缓存和多连接读取保持关闭。
# 用户附件与解析产物必须存放仓库之外；留空使用用户应用数据目录
ATTACHMENTS_DIR=
# 可选：解析 Python；npm run install:attachments 安装后自动选用
ATTACHMENTS_PYTHON=
# 可选：LibreOffice 可执行文件；也自动识别私有 attachment-office 安装目录
ATTACHMENTS_LIBREOFFICE=
# 可选：图片读取模型，留空复用 AGENT_MODEL
ATTACHMENTS_VISION_MODEL=
