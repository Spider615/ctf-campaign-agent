{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["server.ts", "run-turn.ts", "skills.ts", "skill-smoke.ts", "analytics-evaluation.ts", "analytics-skill-run-turn.ts", "analytics-skill-evaluation.ts", "usage/*.ts"]
}
