# 容器部署（butler）按这份清单填环境变量；本地开发用 .dev.vars，见 .dev.vars.example。
# 页面和 Agent 在同一个容器里走回环地址，Agent 的地址、端口和口令由 scripts/start-container.mjs 固定，容器里不用配。
# 必填：公司统一模型网关的 key，不能随机生成
JUZI_MODELS_KEY=
# 模型和网关地址（OpenAI 兼容接口，Agent 内部转成 Anthropic 协议给 SDK 用）
AGENT_MODEL=claude-5.5-sonnet
MODEL_GATEWAY_URL=https://unified-kiro-gateway.juzibot.com/models/v1
# 网关给模型配的单次输出上限，超了会 400；claude-5.5-sonnet 是 8192
MODEL_MAX_OUTPUT_TOKENS=8192
# 设为 1 时日志会打印每次工具调用的参数和结果（含活动内容），只在排查时打开
AGENT_DEBUG=0
# 页面对外端口
PORT=8787
# 本地 D1 数据目录，需要挂持久卷
D1_PERSIST_DIR=/data/d1
# 可选：挂载在容器外的历史知识目录；未配置时仍可分析用户导入数据
ANALYTICS_HISTORY_DIR=
# 私有分析运行记录目录，需要挂持久卷，不纳入镜像
ANALYTICS_AUDIT_DIR=
# 内置历史库：填了数据仓库口令，容器启动时自动拉周大福数据导入容器内的 MySQL（第一次约 5 分钟），
# 并替应用填好下面的 CTF_MYSQL_*。口令是 GitLab 私有仓库 hackathon/ctf-campaign-data 的只读 deploy token，不能随机生成。
CTF_DATA_REPO_TOKEN=
CTF_DATA_REPO_USER=gitlab+deploy-token-4
CTF_DATA_REPO=https://gitlab.agents.juzibot.com/hackathon/ctf-campaign-data.git
# 内置库的数据目录，需要挂持久卷
CTF_MYSQL_DATA_DIR=/data/mysql
# 洞察图谱查询结果缓存，需要挂持久卷
CTF_INSIGHT_CACHE_DIR=/data/insight-cache
# 可选：只读历史数据库；配了上面的数据仓库口令时由容器自动填，不用配
CTF_MYSQL_HOST=
CTF_MYSQL_PORT=3306
CTF_MYSQL_USER=
CTF_MYSQL_PASSWORD=
CTF_MYSQL_DATABASE=
CTF_MYSQL_TABLE=
# 私有查询证据目录，需要挂持久卷，不纳入镜像
CTF_MYSQL_EVIDENCE_DIR=/data/mysql-evidence
# 分析问答仅复用当前只读事务的查询结果；源修订尚未可靠确认，跨会话缓存和多连接读取保持关闭。
# 用户上传文件持久卷，必须位于仓库之外
ATTACHMENTS_DIR=/data/attachments
# 镜像已安装的解析 Python
ATTACHMENTS_PYTHON=/opt/attachment-python/bin/python3
# 镜像默认使用系统 LibreOffice，另装时可覆盖其可执行文件路径
ATTACHMENTS_LIBREOFFICE=
# 可选：图片读取模型，留空复用 AGENT_MODEL
ATTACHMENTS_VISION_MODEL=
