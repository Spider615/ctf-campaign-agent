# 容器部署（butler）按这份清单填环境变量；本地开发用 .dev.vars，见 .dev.vars.example。
# 页面和 Agent 在同一个容器里走回环地址，Agent 的地址、端口和口令由 scripts/start-container.mjs 固定，容器里不用配。
# 必填：DeepSeek 开放平台申请的 API Key，不能随机生成
DEEPSEEK_API_KEY=
# 模型和 Anthropic 兼容接口地址
AGENT_MODEL=deepseek-flash
AGENT_MODEL_BASE_URL=https://api.deepseek.com/anthropic
# 设为 1 时日志会打印每次工具调用的参数和结果（含活动内容），只在排查时打开
AGENT_DEBUG=0
# 页面对外端口
PORT=8787
# 本地 D1 数据目录，需要挂持久卷
D1_PERSIST_DIR=/data/d1
# 可选：挂载在容器外的历史知识目录；未配置时仍可分析用户导入数据
ANALYTICS_HISTORY_DIR=
# 私有分析运行记录目录，需要挂持久卷，不纳入镜像
ANALYTICS_AUDIT_DIR=
# 可选：只读历史数据库；容器中HOST指数据库实际地址
CTF_MYSQL_HOST=
CTF_MYSQL_PORT=3306
CTF_MYSQL_USER=
CTF_MYSQL_PASSWORD=
CTF_MYSQL_DATABASE=
CTF_MYSQL_TABLE=
# 私有查询证据目录，需要挂持久卷，不纳入镜像
CTF_MYSQL_EVIDENCE_DIR=
# 用户上传文件持久卷，必须位于仓库之外
ATTACHMENTS_DIR=/data/attachments
# 镜像已安装的解析 Python
ATTACHMENTS_PYTHON=/opt/attachment-python/bin/python3
# 镜像默认使用系统 LibreOffice，另装时可覆盖其可执行文件路径
ATTACHMENTS_LIBREOFFICE=
ATTACHMENTS_VISION_MODEL=deepseek-flash
